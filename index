  <!-- JAVASCRIPT GAME LOGIC -->
  <script>
    // Global States
    let soundEnabled = true;
    let selectedMode = 'individu'; // 'individu' or 'kelompok'
    let currentQuestionIndex = 0;
    let questions = [];
    let userAnswers = []; // stores { question, options, correctIndex, selectedIndex, isCorrect, timeTaken, explanation }
    let score = 0;
    
    // Per-question Timer Configuration
    const PER_QUESTION_TIME = 120; // 2 minutes per question
    let secondsLeft = PER_QUESTION_TIME;
    let timerInterval = null;
    let questionStartTime = 0;

    // Team Mode State
    let teams = []; // [{ name: "Tim A", score: 0, correct: 0, wrong: 0 }]
    let currentTeamIndex = 0;

    // --- Web Audio API Synthetic Sound FX ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playSound(type) {
      if (!soundEnabled) return;
      try {
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (type === 'correct') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
          osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.2); // A5
          gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        } else if (type === 'wrong') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(220, audioCtx.currentTime); // A3
          osc.frequency.exponentialRampToValueAtTime(110, audioCtx.currentTime + 0.25); // A2
          gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        } else if (type === 'click') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(450, audioCtx.currentTime);
          gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.08);
        } else if (type === 'timeup') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(300, audioCtx.currentTime);
          osc.frequency.setValueAtTime(150, audioCtx.currentTime + 0.2);
          gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.4);
        } else if (type === 'win') {
          const notes = [523.25, 659.25, 783.99, 1046.50];
          notes.forEach((freq, idx) => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g);
            g.connect(audioCtx.destination);
            o.frequency.value = freq;
            g.gain.setValueAtTime(0.12, audioCtx.currentTime + idx * 0.1);
            g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.1 + 0.3);
            o.start(audioCtx.currentTime + idx * 0.1);
            o.stop(audioCtx.currentTime + idx * 0.1 + 0.3);
          });
        }
      } catch (e) {
        console.log("Audio API Error:", e);
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const icon = document.getElementById('soundIcon');
      if (soundEnabled) {
        icon.className = 'fas fa-volume-up text-lg text-theme-600';
      } else {
        icon.className = 'fas fa-volume-mute text-lg text-slate-400';
      }
    }

    // --- Screen Navigation ---
    function showScreen(screenName) {
      document.getElementById('screenHome').classList.add('hidden');
      document.getElementById('screenGame').classList.add('hidden');
      document.getElementById('screenResult').classList.add('hidden');

      if (screenName === 'home') document.getElementById('screenHome').classList.remove('hidden');
      if (screenName === 'game') document.getElementById('screenGame').classList.remove('hidden');
      if (screenName === 'result') document.getElementById('screenResult').classList.remove('hidden');
    }

    // --- Mode & Setup Handlers ---
    function selectMode(mode) {
      playSound('click');
      selectedMode = mode;

      const indCard = document.getElementById('modeIndividuCard');
      const kelCard = document.getElementById('modeKelompokCard');
      const setupForm = document.getElementById('setupForm');
      const inputIndividuWrapper = document.getElementById('inputIndividuWrapper');
      const inputKelompokWrapper = document.getElementById('inputKelompokWrapper');

      setupForm.classList.remove('hidden');

      if (mode === 'individu') {
        indCard.classList.add('border-theme-500', 'bg-theme-50/50');
        kelCard.classList.remove('border-theme-500', 'bg-theme-50/50');
        inputIndividuWrapper.classList.remove('hidden');
        inputKelompokWrapper.classList.add('hidden');
      } else {
        kelCard.classList.add('border-theme-500', 'bg-theme-50/50');
        indCard.classList.remove('border-theme-500', 'bg-theme-50/50');
        inputKelompokWrapper.classList.remove('hidden');
        inputIndividuWrapper.classList.add('hidden');
        updateTeamInputs();
      }
    }

    function updateTeamInputs() {
      const count = parseInt(document.getElementById('teamCountSelect').value);
      const container = document.getElementById('teamNamesContainer');
      container.innerHTML = '';

      for (let i = 1; i <= count; i++) {
        const div = document.createElement('div');
        div.innerHTML = `
          <label class="block text-[11px] font-semibold text-slate-500">Nama Kelompok ${i}:</label>
          <input type="text" id="teamInput_${i}" value="Kelompok ${String.fromCharCode(64 + i)}" class="w-full px-3 py-1.5 rounded-lg border border-theme-200 focus:outline-none focus:ring-1 focus:ring-theme-500 text-xs bg-white">
        `;
        container.appendChild(div);
      }
    }

    // --- Math Questions Generator (15 Questions) ---
    function generateMathQuestions(count = 15) {
      const list = [];
      const operators = ['+', '-', '*', '/'];

      for (let i = 0; i < count; i++) {
        let op = operators[Math.floor(Math.random() * operators.length)];
        let num1, num2, correctAnswer, text, explanation;

        if (op === '+') {
          num1 = Math.floor(Math.random() * 90) + 10;
          num2 = Math.floor(Math.random() * 90) + 10;
          correctAnswer = num1 + num2;
          text = `${num1} + ${num2}`;
          explanation = `Penjumlahan sederhana: ${num1} ditambah ${num2} menghasilkan ${correctAnswer}.`;
        } else if (op === '-') {
          num1 = Math.floor(Math.random() * 95) + 10;
          num2 = Math.floor(Math.random() * num1) + 1;
          correctAnswer = num1 - num2;
          text = `${num1} - ${num2}`;
          explanation = `Pengurangan: ${num1} dikurangi ${num2} sisa ${correctAnswer}.`;
        } else if (op === '*') {
          num1 = Math.floor(Math.random() * 12) + 2;
          num2 = Math.floor(Math.random() * 12) + 2;
          correctAnswer = num1 * num2;
          text = `${num1} × ${num2}`;
          explanation = `Perkalian: ${num1} dikali ${num2} sama dengan ${correctAnswer}.`;
        } else if (op === '/') {
          num2 = Math.floor(Math.random() * 10) + 2;
          correctAnswer = Math.floor(Math.random() * 12) + 1;
          num1 = num2 * correctAnswer;
          text = `${num1} ÷ ${num2}`;
          explanation = `Pembagian: ${num1} dibagi ${num2} adalah ${correctAnswer}.`;
        }

        // Generate options
        const optionsSet = new Set([correctAnswer]);
        while (optionsSet.size < 4) {
          let offset = (Math.floor(Math.random() * 8) + 1) * (Math.random() < 0.5 ? 1 : -1);
          let wrong = correctAnswer + offset;
          if (wrong >= 0) {
            optionsSet.add(wrong);
          }
        }

        const options = Array.from(optionsSet).sort(() => Math.random() - 0.5);
        const answerIndex = options.indexOf(correctAnswer);

        list.push({
          text: text,
          options: options,
          answerIndex: answerIndex,
          explanation: explanation
        });
      }

      return list;
    }

    // --- Start Game Logic ---
    function startGame() {
      playSound('click');

      if (selectedMode === 'kelompok') {
        const count = parseInt(document.getElementById('teamCountSelect').value);
        teams = [];
        for (let i = 1; i <= count; i++) {
          const inputVal = document.getElementById(`teamInput_${i}`).value.trim();
          teams.push({
            name: inputVal || `Kelompok ${String.fromCharCode(64 + i)}`,
            score: 0,
            correct: 0,
            wrong: 0
          });
        }
        currentTeamIndex = 0;
      }

      initRound();
    }

    function initRound() {
      currentQuestionIndex = 0;
      score = 0;
      userAnswers = [];
      questions = generateMathQuestions(15);

      // Update Team Badge Header
      const teamTurnBadge = document.getElementById('teamTurnBadge');
      if (selectedMode === 'kelompok') {
        teamTurnBadge.classList.remove('hidden');
        document.getElementById('currentTeamName').innerText = teams[currentTeamIndex].name;
      } else {
        teamTurnBadge.classList.add('hidden');
      }

      document.getElementById('scoreText').innerText = '0';
      showScreen('game');
      renderQuestion();
    }

    // --- Mascot SVG Renderer (State based) ---
    function renderMascot(state, bubbleText) {
      const container = document.getElementById('gameMascotContainer');
      const bubble = document.getElementById('mascotBubble');
      bubble.innerText = bubbleText;

      let eyeSvg = `<circle cx="75" cy="90" r="8" fill="#0C4A6E"/><circle cx="125" cy="90" r="8" fill="#0C4A6E"/>`;
      let mouthSvg = `<polygon points="100,98 90,110 110,110" fill="#F59E0B"/>`;

      if (state === 'happy') {
        eyeSvg = `<path d="M 68,90 Q 75,80 82,90" stroke="#0C4A6E" stroke-width="4" fill="none"/>
                  <path d="M 118,90 Q 125,80 132,90" stroke="#0C4A6E" stroke-width="4" fill="none"/>`;
        mouthSvg = `<ellipse cx="100" cy="106" rx="10" ry="8" fill="#F59E0B"/>`;
      } else if (state === 'thinking') {
        eyeSvg = `<circle cx="78" cy="86" r="7" fill="#0C4A6E"/><circle cx="128" cy="86" r="7" fill="#0C4A6E"/>`;
      } else if (state === 'sad') {
        eyeSvg = `<path d="M 68,85 Q 75,95 82,85" stroke="#0C4A6E" stroke-width="4" fill="none"/>
                  <path d="M 118,85 Q 125,95 132,85" stroke="#0C4A6E" stroke-width="4" fill="none"/>`;
      }

      container.innerHTML = `
        <svg viewBox="0 0 200 200" class="w-full h-full drop-shadow-md">
          <circle cx="100" cy="105" r="70" fill="#0EA5E9"/>
          <circle cx="100" cy="115" r="50" fill="#E0EFFE"/>
          <polygon points="100,20 160,40 100,60 40,40" fill="#0C4A6E"/>
          <circle cx="75" cy="90" r="18" fill="none" stroke="#0C4A6E" stroke-width="3.5"/>
          <circle cx="125" cy="90" r="18" fill="none" stroke="#0C4A6E" stroke-width="3.5"/>
          <line x1="93" y1="90" x2="107" y2="90" stroke="#0C4A6E" stroke-width="3.5"/>
          ${eyeSvg}
          ${mouthSvg}
        </svg>
      `;
    }

    // --- Render Question & Start Per-Question 2 Minute Timer ---
    function renderQuestion() {
      if (currentQuestionIndex >= questions.length) {
        endGame();
        return;
      }

      const q = questions[currentQuestionIndex];
      document.getElementById('currentQuestionNum').innerText = currentQuestionIndex + 1;
      document.getElementById('questionMath').innerText = `${q.text} = ?`;

      // Set Mascot state to thinking
      const mascotMessages = [
        "Yuk fokus, 2 menit per soal!",
        "Pikirkan dengan teliti ya!",
        "Kamu pasti bisa menjawab ini!",
        "Hitung baik-baik ya!"
      ];
      renderMascot('thinking', mascotMessages[Math.floor(Math.random() * mascotMessages.length)]);

      const optionsGrid = document.getElementById('optionsGrid');
      optionsGrid.innerHTML = '';
      const labels = ['A', 'B', 'C', 'D'];

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.onclick = () => handleAnswer(idx);
        btn.className = `option-btn w-full p-3.5 sm:p-4 rounded-xl border-2 border-theme-200 bg-white font-bold text-slate-800 flex items-center justify-between text-base sm:text-lg shadow-sm font-fredoka`;
        btn.innerHTML = `
          <span class="w-7 h-7 rounded-lg bg-theme-100 text-theme-700 flex items-center justify-center font-bold text-xs sm:text-sm">${labels[idx]}</span>
          <span>${opt}</span>
          <span class="w-7"></span>
        `;
        optionsGrid.appendChild(btn);
      });

      // Start / Reset Timer 2 Minutes for THIS question
      startPerQuestionTimer();
    }

    // --- Per-Question Timer Logic (Resets to 120s each question) ---
    function startPerQuestionTimer() {
      clearInterval(timerInterval);
      secondsLeft = PER_QUESTION_TIME; // Reset to 120s
      questionStartTime = Date.now();
      updateTimerUI();

      timerInterval = setInterval(() => {
        secondsLeft--;
        updateTimerUI();

        if (secondsLeft <= 0) {
          clearInterval(timerInterval);
          playSound('timeup');
          // Handle time out as un-answered wrong
          handleAnswer(-1, true);
        }
      }, 1000);
    }

    function updateTimerUI() {
      const mins = Math.floor(secondsLeft / 60);
      const secs = secondsLeft % 60;
      document.getElementById('timerText').innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      const percent = (secondsLeft / PER_QUESTION_TIME) * 100;
      const bar = document.getElementById('timerBar');
      bar.style.width = `${percent}%`;

      if (secondsLeft <= 20) {
        bar.className = 'bg-red-500 h-full transition-all duration-1000 ease-linear';
      } else if (secondsLeft <= 40) {
        bar.className = 'bg-amber-500 h-full transition-all duration-1000 ease-linear';
      } else {
        bar.className = 'bg-theme-500 h-full transition-all duration-1000 ease-linear';
      }
    }

    // --- Handle User Answer ---
    function handleAnswer(selectedIndex, isTimeUp = false) {
      clearInterval(timerInterval);
      const timeTaken = Math.round((Date.now() - questionStartTime) / 1000);

      const q = questions[currentQuestionIndex];
      const isCorrect = selectedIndex === q.answerIndex;

      // Disable buttons
      const btns = document.querySelectorAll('.option-btn');
      btns.forEach(b => b.disabled = true);

      if (!isTimeUp && selectedIndex >= 0) {
        btns[selectedIndex].classList.remove('border-theme-200', 'bg-white');
        if (isCorrect) {
          btns[selectedIndex].classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');
          playSound('correct');
          score += 10;
          document.getElementById('scoreText').innerText = score;
          renderMascot('happy', "Hore! Jawabanmu Tepat Sekali! 🎉");
        } else {
          btns[selectedIndex].classList.add('border-red-500', 'bg-red-50', 'text-red-800');
          btns[q.answerIndex].classList.remove('border-theme-200');
          btns[q.answerIndex].classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');
          playSound('wrong');
          renderMascot('sad', "Waduh, belum tepat. Tetap semangat!");
        }
      } else {
        // Time Up
        btns[q.answerIndex].classList.remove('border-theme-200');
        btns[q.answerIndex].classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-800');
        renderMascot('sad', "Waktu 2 menit habis! Lanjut ke soal berikutnya.");
      }

      // Record result
      userAnswers.push({
        question: q.text,
        options: q.options,
        correctIndex: q.answerIndex,
        selectedIndex: selectedIndex,
        isCorrect: isCorrect,
        timeTaken: timeTaken,
        explanation: q.explanation
      });

      // Advance after delay
      setTimeout(() => {
        currentQuestionIndex++;
        renderQuestion();
      }, 1200);
    }

    // --- End Game & Results ---
    function endGame() {
      clearInterval(timerInterval);

      const correctCount = userAnswers.filter(a => a.isCorrect).length;
      const wrongCount = userAnswers.length - correctCount;
      const accuracy = Math.round((correctCount / questions.length) * 100);
      const totalTimeTaken = userAnswers.reduce((acc, curr) => acc + curr.timeTaken, 0);
      const avgTime = Math.round(totalTimeTaken / questions.length);

      // Save team score
      if (selectedMode === 'kelompok') {
        teams[currentTeamIndex].score = score;
        teams[currentTeamIndex].correct = correctCount;
        teams[currentTeamIndex].wrong = wrongCount;
      }

      // Fill UI
      document.getElementById('resTotalScore').innerText = score;
      document.getElementById('resCorrect').innerText = correctCount;
      document.getElementById('resWrong').innerText = wrongCount;
      document.getElementById('resAccuracy').innerText = `${accuracy}%`;
      document.getElementById('resAvgTime').innerText = `${avgTime} dtk/soal`;

      const title = document.getElementById('resultTitle');
      const sub = document.getElementById('resultSubtitle');
      const nextBtn = document.getElementById('nextTeamOrRestartBtn');
      const groupWrapper = document.getElementById('groupLeaderboardWrapper');

      if (selectedMode === 'kelompok') {
        const currentTeam = teams[currentTeamIndex];
        title.innerText = `Selesai: ${currentTeam.name}!`;

        if (currentTeamIndex < teams.length - 1) {
          sub.innerText = `Skor tersimpan. Giliran ${teams[currentTeamIndex + 1].name} selanjutnya!`;
          nextBtn.innerHTML = `<i class="fas fa-users"></i> Lanjut Ke ${teams[currentTeamIndex + 1].name}`;
        } else {
          sub.innerText = `Semua kelompok selesai! Berikut hasil akhirnya:`;
          nextBtn.innerHTML = `<i class="fas fa-redo"></i> Main Ulang dari Awal`;
        }

        groupWrapper.classList.remove('hidden');
        renderGroupLeaderboard();

      } else {
        groupWrapper.classList.add('hidden');
        const pName = document.getElementById('playerName').value.trim() || 'Pemain';

        if (accuracy >= 80) {
          title.innerText = `Hebat Banget, ${pName}! 🏆`;
          sub.innerText = `Kamu jenius matematika! Hasil yang sangat memuaskan.`;
        } else if (accuracy >= 50) {
          title.innerText = `Bagus Sekali, ${pName}! 👍`;
          sub.innerText = `Kemampuan matematikamu sudah cukup baik, tingkatkan lagi ya!`;
        } else {
          title.innerText = `Semangat Terus, ${pName}! 💪`;
          sub.innerText = `Coba latihan lagi untuk mendapat skor yang lebih tinggi!`;
        }

        nextBtn.innerHTML = `<i class="fas fa-redo"></i> Main Lagi`;
      }

      showScreen('result');

      if (accuracy >= 60) {
        playSound('win');
        triggerConfetti();
      }
    }

    function renderGroupLeaderboard() {
      const tbody = document.getElementById('groupLeaderboardBody');
      tbody.innerHTML = '';

      const sorted = [...teams].sort((a, b) => b.score - a.score);

      sorted.forEach((team, idx) => {
        const tr = document.createElement('tr');
        tr.className = idx === 0 ? 'bg-amber-50 font-bold border-b border-theme-100' : 'border-b border-theme-100';

        let medal = `#${idx + 1}`;
        if (idx === 0) medal = '🥇 1st';
        if (idx === 1) medal = '🥈 2nd';
        if (idx === 2) medal = '🥉 3rd';

        tr.innerHTML = `
          <td class="p-2">${medal}</td>
          <td class="p-2 font-bold text-slate-800">${team.name}</td>
          <td class="p-2 text-emerald-600">${team.correct} / 15</td>
          <td class="p-2 text-theme-600 font-extrabold">${team.score}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function restartOrNextTeam() {
      if (selectedMode === 'kelompok') {
        if (currentTeamIndex < teams.length - 1) {
          currentTeamIndex++;
          initRound();
        } else {
          currentTeamIndex = 0;
          initRound();
        }
      } else {
        initRound();
      }
    }

    function confirmQuit() {
      if (confirm('Apakah kamu yakin ingin keluar? Progres soal akan dihentikan.')) {
        clearInterval(timerInterval);
        showScreen('home');
      }
    }

    // --- Review Modal Logic ---
    function toggleReviewModal(show) {
      playSound('click');
      const modal = document.getElementById('reviewModal');
      if (show) {
        populateReviewList();
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    function populateReviewList() {
      const container = document.getElementById('reviewList');
      container.innerHTML = '';

      userAnswers.forEach((ans, idx) => {
        const div = document.createElement('div');
        const isUserCorrect = ans.isCorrect;

        div.className = `p-3.5 rounded-2xl border ${isUserCorrect ? 'border-emerald-200 bg-emerald-50/60' : 'border-red-200 bg-red-50/60'} space-y-1.5`;

        const userChoiceText = ans.selectedIndex >= 0 ? ans.options[ans.selectedIndex] : 'Waktu habis (Tidak dijawab)';
        const correctChoiceText = ans.options[ans.correctIndex];

        div.innerHTML = `
          <div class="flex justify-between items-center">
            <span class="font-bold text-slate-800 font-fredoka">Soal #${idx + 1}: ${ans.question}</span>
            <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full font-bold ${isUserCorrect ? 'bg-emerald-200 text-emerald-800' : 'bg-red-200 text-red-800'}">
              ${isUserCorrect ? 'Benar (+10)' : 'Salah'}
            </span>
          </div>
          <div class="text-xs space-y-1">
            <p class="text-slate-600">Jawaban Kamu: <span class="font-bold ${isUserCorrect ? 'text-emerald-700' : 'text-red-700'}">${userChoiceText}</span> (${ans.timeTaken} detik)</p>
            ${!isUserCorrect ? `<p class="text-slate-600">Jawaban Benar: <span class="font-bold text-emerald-700">${correctChoiceText}</span></p>` : ''}
            <p class="text-[11px] text-slate-500 italic bg-white/70 p-2 rounded-lg mt-1 border border-slate-100">💡 <b>Pembahasan:</b> ${ans.explanation}</p>
          </div>
        `;
        container.appendChild(div);
      });
    }

    // --- Confetti FX ---
    function triggerConfetti() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 90,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
    }

    // On Load Initializer
    window.onload = function() {
      selectMode('individu');
    };
  </script>

